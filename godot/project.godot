; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="BVN 2.6 Godot Port"
run/main_scene="res://render_surface.tscn"

[display]

window/size/viewport_width=600
window/size/viewport_height=400
window/size/window_width_override=900
window/size/window_height_override=600
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false


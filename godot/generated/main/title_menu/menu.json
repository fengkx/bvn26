  "source_scripts": {
    "DefineSprite_597/frame_1/DoAction.as": "_parent.anj = 0;\r\nstop();\r\n",
    "DefineSprite_597/frame_15/DoAction.as": "_root.txtst = 0;\r\n_root.modo = 2;\r\n_root.p1cpu = false;\r\n_root.p2cpu = true;\r\n_root.gotoAndStop(\"选人画面\");\r\n",
    "DefineSprite_620/frame_1/PlaceObject2_619_28/CLIPACTIONRECORD onClipEvent(enterFrame).as": "onClipEvent(enterFrame){\r\n   if(an == 0)\r\n   {\r\n      if(_parent.anj == 0)\r\n      {\r\n         if(Key.isDown(_root.w))\r\n         {\r\n            _root.keysound1.start();\r\n            if(select == 1)\r\n            {\r\n               select = 9;\r\n            }\r\n            else\r\n            {\r\n               select -= 1;\r\n            }\r\n            an = 1;\r\n         }\r\n         if(Key.isDown(_root.s))\r\n         {\r\n            _root.keysound1.start();\r\n            if(select == 8)\r\n            {\r\n               select = 11;\r\n            }\r\n            else\r\n            {\r\n               select += 1;\r\n            }\r\n            an = 1;\r\n         }\r\n         if(Key.isDown(_root.j))\r\n         {\r\n            _root.keysound2.start();\r\n            _parent[\"btm\" + select].play();\r\n            _parent.anj = 1;\r\n         }\r\n      }\r\n   }\r\n   if(_parent[\"btm\" + select]._y < -5)\r\n   {\r\n      i = 1;\r\n      while(i < 15)\r\n      {\r\n         _parent[\"btm\" + i]._y += spd;\r\n         i++;\r\n      }\r\n   }\r\n   if(_parent[\"btm\" + select]._y > 5)\r\n   {\r\n      i = 1;\r\n      while(i < 15)\r\n      {\r\n         _parent[\"btm\" + i]._y -= spd;\r\n         i++;\r\n      }\r\n   }\r\n   if(_parent[\"btm\" + select]._y > -6 and _parent[\"btm\" + select]._y < 6)\r\n   {\r\n      if(select == 9)\r\n      {\r\n         _parent.btm1._y = -403.5;\r\n         _parent.btm2._y = -347.6;\r\n         _parent.btm3._y = -291.7;\r\n         _parent.btm4._y = -235.8;\r\n         _parent.btm5._y = -173.9;\r\n         _parent.btm6._y = -112;\r\n         _parent.btm7._y = -56.1;\r\n         _parent.btm8._y = -0.2;\r\n         _parent.btm9._y = -460.3;\r\n         _parent.btm10._y = -516.2;\r\n         _parent.btm11._y = 56.1;\r\n         _parent.btm12._y = 112;\r\n         select = 8;\r\n      }\r\n      if(select =
      "            return true;",
      "         }",
      "         return false;",
      "      }",
      "   }",
      "   if(!hitBan && !touch)",
      "   {",
      "      return false;",
      "   }",
      "   var _loc3_;",
      "   var _loc5_ = Math.abs(_loc4_._x - _parent._x);",
      "   if(动作 == 1 && _loc4_.mc.动作 == -1)",
      "   {",
      "      _loc3_ = goran < 40;",
      "   }",
      "   if(动作 == 2 && _loc4_.mc.动作 == 1)",
      "   {",
      "      _loc3_ = goran < 30;",
      "   }",
      "   if(动作 == 1)",
      "   {",

      "path": "DefineSprite_1991/frame_1/DoAction.as",
      "source_suffix": "var _kn = 0;\r\nvar _knys = [-39,9,55];\r\nonKeyUp = function()\r\n{\r\n   if(_root._menuEnabled === false)\r\n   {\r\n      return undefined;\r\n   }\r\n   var _loc3_ = Key.getCode();\r\n   trace(_loc3_);\r\n   var _loc2_ = _root.game_menu;\r\n   if(_loc2_._visible == false)\r\n   {\r\n      if(_loc3_ == 13)\r\n      {\r\n         _root.pauseGame2();\r\n         _kn = 2;\r\n         _loc2_.skk._y = _knys[_kn];\r\n         _loc2_._visible = true;\r\n         _loc2_.gotoAndStop(1);\r\n      }\r\n      return undefined;\r\n   }\r\n   if(_loc3_ == 13)\r\n   {\r\n      switch(_kn)\r\n      {\r\n         case 0:\r\n            _root.gotoAndStop(\"MENU\");\r\n            break;\r\n         case 1:\r\n            _kn = 2;\r\n            _loc2_.play();\r\n            break;\r\n         case 2:\r\n            _root.resumeGame2();\r\n            _loc2_._visible = false;\r\n      }\r\n   }\r\n   if(_loc3_ == 40)\r\n   {\r\n      if(_kn < _knys.length - 1)\r\n      {\r\n         _kn += 1;\r\n      }\r\n      else\r\n      {\r\n         _kn = 0;\r\n      }\r\n      _loc2_.skk._y = _knys[_kn];\r\n   }\r\n   if(_loc3_ == 38)\r\n   {\r\n      if(_kn > 0)\r\n      {\r\n         _kn -= 1;\r\n      }\r\n      else\r\n      {\r\n         _kn = _knys.length - 1;\r\n      }\r\n      _loc2_.skk._y = _knys[_kn];\r\n   }\r\n};\r\nKey.addListener(this);\r\n"
    }

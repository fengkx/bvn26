          "source": "onClipEvent(enterFrame){\r\n   if(_root.zhanting == false)\r\n   {\r\n      if(_parent._parent._xscale > 0)\r\n      {\r\n         _parent._parent._x += _parent.speed;\r\n      }\r\n      else\r\n      {\r\n         _parent._parent._x -= _parent.speed;\r\n      }\r\n      _parent._parent._y += _parent.speed * 2;\r\n      if(_parent.touch == true)\r\n      {\r\n         _parent.gotoAndPlay(\"跳砍2\");\r\n      }\r\n   }\r\n}\r\n"
        }

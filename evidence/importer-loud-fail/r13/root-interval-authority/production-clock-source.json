      "text": "\t# Pauses/recovery do not advance frames; rollback derives identical samples."
    },
    {
      "line": 755,
      "text": "\tvar elapsed_ms := (frame * 1000) / 30"
    },
    {
      "line": 756,
      "text": "\tvar problem: String = timers.set_time(elapsed_ms)"
    },
    {
      "line": 757,
      "text": "\tif not problem.is_empty(): return problem"
    },
    {
      "line": 758,
      "text": "\tproblem = battle.set_frame_clock(frame, elapsed_ms)"
    },
    {
      "line": 759,
      "text": "\tif not problem.is_empty(): return problem"
    },
    {
      "line": 760,
      "text": "\tif _intro_skip_frames.has(frame):"
    },

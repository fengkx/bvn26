      "source": "stop();\r\n_root.gametime = _root.maxtime;\r\ntime = function()\r\n{\r\n   if(_root.zhanting == false)\r\n   {\r\n      if(_root.game.p1.mc.sw == false and _root.game.p2.mc.sw == false)\r\n      {\r\n         if(_root.modo != 4)\r\n         {\r\n            _root.gametime -= 1;\r\n         }\r\n      }\r\n   }\r\n   tm = _root.gametime;\r\n   if(tm <= 0)\r\n   {\r\n      if(_root.timeover.played == 0)\r\n      {\r\n         _root.to = true;\r\n         _root.timeover.play();\r\n         played = 1;\r\n      }\r\n      tm = 0;\r\n   }\r\n   else\r\n   {\r\n      _root.to = false;\r\n   }\r\n   if(tm >= 10)\r\n   {\r\n      shi = Math.floor(tm / 10);\r\n      gs = tm - shi * 10;\r\n   }\r\n   if(tm < 10)\r\n   {\r\n      shi = 0;\r\n      gs = tm;\r\n   }\r\n   十.gotoAndStop(shi + 1);\r\n   个.gotoAndStop(gs + 1);\r\n};\r\nif(_root.maxtime == 100 or _root.modo == 4)\r\n{\r\n   gotoAndStop(\"无限时\");\r\n}\r\nelse\r\n{\r\n   _root.timeset = setInterval(time,1000);\r\n}\r\n"

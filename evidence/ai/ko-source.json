      "path": "DefineSprite_1858/frame_84/DoAction.as",
      "source": "if(_root.game.p1.mc.hp == _root.game.p2.mc.hp)\r\n{\r\n   gotoAndStop(\"drawgame\");\r\n   play();\r\n}\r\nelse\r\n{\r\n   gotoAndStop(\"winner\");\r\n   play();\r\n}\r\n",
      "sha256": "99ed787200e522a8af03e58553293663c341e5f380125fa02001a143dfacde89"
    },
    "94": {
      "path": "DefineSprite_1858/frame_94/DoAction.as",
      "source": "if(_root.game.p1.mc.hp > _root.game.p2.mc.hp)\r\n{\r\n   _root.p1ws += 1;\r\n   _root.updateWins();\r\n   _root.焦点 = \"p1\";\r\n   winmc._x = 0;\r\n}\r\nelse\r\n{\r\n   _root.p2ws += 1;\r\n   _root.updateWins();\r\n   _root.焦点 = \"p2\";\r\n   winmc._x = 120;\r\n}\r\n",
      "sha256": "705c500365708ded135cca36ac1f7368a7e704b88d55bbbd02704b68383a4cc2"
    }

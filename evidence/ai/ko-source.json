    "pauseGame": {
      "path": "frame_8/DoAction.as#pauseGame",
      "source": "function pauseGame()\r\n{\r\n   if(_root.gamePaused)\r\n   {\r\n      return undefined;\r\n   }\r\n   _root.zhanting = true;\r\n   stopMc(_root.game.p1.mc);\r\n   stopMc(_root.game.p2.mc);\r\n   stopMc(_root.game.p1fz);\r\n   stopMc(_root.game.p2fz);\r\n}",
      "sha256": "e74ef928db0a167b0e09df49682fe41a9787fea9f25e02b93f43911eeb75224b"
    },
    "resumeGame": {
      "path": "frame_8/DoAction.as#resumeGame",
      "source": "function resumeGame()\r\n{\r\n   if(koPause)\r\n   {\r\n      return undefined;\r\n   }\r\n   if(_root.gamePaused)\r\n   {\r\n      return undefined;\r\n   }\r\n   _root.zhanting = false;\r\n   playMc(_root.game.p1.mc);\r\n   playMc(_root.game.p2.mc);\r\n   playMc(_root.game.p1fz);\r\n   playMc(_root.game.p2fz);\r\n   resumeBlackStg();\r\n}",
      "sha256": "7a05c143301716b0f749d00360ed45e1b97b3ad48c04e14116958dabb8b2c862"
    },
    "resumeGame2": {
      "path": "frame_8/DoAction.as#resumeGame2",
      "source": "function resumeGame2()\r\n{\r\n   _root.gamePaused = false;\r\n   resumeGame();\r\n}",
      "sha256": "783a3f5802a4098adcbe499eeda9d97db454dfc1c5910480ae40ae2d032e448c"
    },
    "stopMc": {
      "path": "frame_8/DoAction.as#stopMc",
      "source": "function stopMc(mc)\r\n{\r\n   if(mc.hited == 0 && mc.bs == 0 && mc.sw === false)\r\n   {\r\n      mc.stop();\r\n   }\r\n}",
      "sha256": "6779454ea4024e356121b8e43370f1b3c866a325ed3262f51ab5783ddbdbd044"
    },
    "playMc": {
      "path": "frame_8/DoAction.as#playMc",
      "source": "function playMc(mc)\r\n{\r\n   if(_root.gamePaused)\r\n   {\r\n      return undefined;\r\n   }\r\n   if(mc.attacking === false)\r\n   {\r\n      return undefined;\r\n   }\r\n   if(mc.hited == 0 && mc.sw === false)\r\n   {\r\n      mc.play();\r\n   }\r\n}",
      "sha256": "19cba74f6deda509193208399faafdfee1e9d0a3c401e7a044edc2ae14cff7da"
    }
  },

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bvn-matchmaking",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
      {
        "name": "ADMISSION",
        "class_name": "Admission",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room", "Admission"],
    },
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true,
      "persist": false,
    },
  },
  "routes": [
    {
      "pattern": "bvn26-pvp.fengkx.top",
      "zone_name": "fengkx.top",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "vars": {
    "TURN_KEY_ID": "52afdeb2c09716a62100c64888f86b1e",
  },
}

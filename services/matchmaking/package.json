{
  "name": "@bvn/matchmaking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run typecheck && node --test test/*.test.mjs",
    "test:restart": "node --test --test-name-pattern=restart test/*.test.mjs",
    "format": "prettier --write src test package.json tsconfig.json wrangler.jsonc",
    "format:check": "prettier --check src test package.json tsconfig.json wrangler.jsonc"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20260921.0-alpha",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "wrangler": "4.136.2",
    "ws": "8.21.3"
  }
}

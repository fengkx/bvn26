stop();var seq=0;var caseId=0;
function emit(k,v){trace("AIREF|RUN|"+(seq++)+"|0|0|0|"+k+"|"+v);}
_root.onEnterFrame=function(){var image=flash.display.BitmapData.loadBitmap("jpeg_edge_"+caseId);if(image==undefined){emit("error","missing control "+caseId);delete _root.onEnterFrame;fscommand("quit");return;}emit("case",[caseId,image.width,image.height,image.transparent].join(","));var black=new flash.display.BitmapData(image.width,image.height,false,0);black.draw(image);for(var y=0;y<image.height;y++){var values=[y];for(var x=0;x<image.width;x++)values.push(image.getPixel32(x,y),black.getPixel32(x,y));emit("row",values.join(","));}black.dispose();image.dispose();caseId++;if(caseId==7){delete _root.onEnterFrame;emit("done","ok");fscommand("quit");}};

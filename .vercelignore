# Upload build inputs; dist/web is generated on Vercel.
/*
!/vercel.json
!/godot/
/godot/.godot/
/godot/**/*.import
!/tools/
/tools/*
!/tools/build_web.sh
!/tools/build_online_manifest.py
!/tools/test_online_manifest.py
!/tools/test_online_lobby_ui.py
# Compatibility fingerprints use the service protocol and roster at build time.
!/services/
/services/*
!/services/matchmaking/
/services/matchmaking/*
!/services/matchmaking/src/
/services/matchmaking/src/*
!/services/matchmaking/src/protocol.ts
!/services/matchmaking/src/catalog.json

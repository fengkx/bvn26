{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bvn26:asset:1",
  "title": "BVN 2.6 asset v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "asset"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "status": {
      "enum": [
        "extracted_partial",
        "synthetic_example",
        "ready"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_swf": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "symbol_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "atlas_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_frame": {
            "type": "integer",
            "minimum": 1
          },
          "rect_px": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "pivot_px": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "duration_ticks": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "source_frame",
          "rect_px",
          "pivot_px",
          "duration_ticks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "notes",
    "source_swf",
    "source_sha256",
    "symbol_id",
    "atlas_path",
    "frames"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "symbol_id": {
            "type": "integer",
            "minimum": 0
          },
          "atlas_path": {
            "type": "string",
            "minLength": 1
          },
          "frames": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

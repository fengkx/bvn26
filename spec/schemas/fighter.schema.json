{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bvn26:fighter:1",
  "title": "BVN 2.6 fighter v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "fighter"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "status": {
      "enum": [
        "extracted_partial",
        "synthetic_example",
        "ready"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "source_swf": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "bundle": {
          "type": "string",
          "minLength": 1
        },
        "script_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bundle",
        "script_path"
      ],
      "additionalProperties": false
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "form_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "source_root_frame": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "action_set_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "form_id",
          "source_root_frame",
          "action_set_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "notes",
    "catalog_id",
    "source_swf",
    "source_sha256",
    "source_ref",
    "forms"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "forms": {
            "items": {
              "properties": {
                "source_root_frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "action_set_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                }
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developer whole-match logical input recording v1",
  "type": "object",
  "required": [
    "kind",
    "format",
    "version",
    "complete",
    "setup",
    "events"
  ],
  "properties": {
    "kind": {
      "const": "match-input"
    },
    "format": {
      "const": "bvn-match-input"
    },
    "version": {
      "const": 1
    },
    "complete": {
      "const": true
    },
    "setup": {
      "type": "object",
      "required": [
        "start_tick",
        "engine",
        "stage",
        "modo",
        "ai_level",
        "maxhp",
        "maxtime",
        "fighters",
        "helpers"
      ],
      "properties": {
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "modo": {
          "enum": [
            2,
            3,
            4
          ]
        },
        "ai_level": {
          "enum": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "maxhp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxtime": {
          "type": "integer",
          "minimum": 0
        },
        "fighters": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        },
        "helpers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "tick",
              "skip"
            ],
            "properties": {
              "kind": {
                "const": "intro"
              },
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "skip": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "tick",
              "players"
            ],
            "properties": {
              "kind": {
                "const": "players"
              },
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "players": {
                "type": "object",
                "required": [
                  "p1",
                  "p2"
                ],
                "properties": {
                  "p1": {
                    "$ref": "#/$defs/sample"
                  },
                  "p2": {
                    "$ref": "#/$defs/sample"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "tick",
              "control"
            ],
            "properties": {
              "kind": {
                "const": "control"
              },
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "control": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "button",
                      "pressed"
                    ],
                    "properties": {
                      "button": {
                        "enum": [
                          "up",
                          "down",
                          "confirm"
                        ]
                      },
                      "pressed": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "button",
                      "pressed",
                      "inside"
                    ],
                    "properties": {
                      "button": {
                        "const": "back"
                      },
                      "pressed": {
                        "type": "boolean"
                      },
                      "inside": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "tick",
              "reason"
            ],
            "properties": {
              "kind": {
                "const": "end"
              },
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "enum": [
                  "title",
                  "selection"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "buttons": {
      "type": "object",
      "required": [
        "up",
        "down",
        "left",
        "right",
        "attack",
        "jump",
        "dash",
        "ranged",
        "special",
        "summon"
      ],
      "properties": {
        "up": {
          "type": "boolean"
        },
        "down": {
          "type": "boolean"
        },
        "left": {
          "type": "boolean"
        },
        "right": {
          "type": "boolean"
        },
        "attack": {
          "type": "boolean"
        },
        "jump": {
          "type": "boolean"
        },
        "dash": {
          "type": "boolean"
        },
        "ranged": {
          "type": "boolean"
        },
        "special": {
          "type": "boolean"
        },
        "summon": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "held",
        "pressed",
        "released"
      ],
      "properties": {
        "held": {
          "$ref": "#/$defs/buttons"
        },
        "pressed": {
          "$ref": "#/$defs/buttons"
        },
        "released": {
          "$ref": "#/$defs/buttons"
        }
      },
      "additionalProperties": false
    }
  }
}
